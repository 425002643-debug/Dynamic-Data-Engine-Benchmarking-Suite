#include <iostream>
#include <vector>
#include "SearchSortEngine.h"

int main() {
    SearchSortEngine engine;
    std::vector<int> data = {64, 34, 25, 12, 22, 11, 90};

    std::cout << "Original array size: " << data.size() << "\n\n";

    // Test Bubble Sort
    std::vector<int> testData = data;
    engine.resetCounters();
    engine.bubbleSort(testData);
    std::cout << "Bubble Sort - Comparisons: " << engine.getComparisonCount() 
              << ", Swaps: " << engine.getSwapCount() << "\n";

    // Test Binary Search (on sorted data)
    engine.resetCounters();
    int index = engine.binarySearch(testData, 25);
    std::cout << "Binary Search for 25 found at index: " << index 
              << " (Comparisons: " << engine.getComparisonCount() << ")\n";

    return 0;
}
